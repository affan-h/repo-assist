# Copy to .env and fill in. Never commit .env.

# Required: answers are generated with Gemini (free tier works).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Recommended: lets ingestion fetch issues, PRs, discussions and release notes.
# A classic token with public-repo read access, or: export GITHUB_TOKEN=$(gh auth token)
GITHUB_TOKEN=

# Optional overrides (pydantic-ai model strings; defaults use the Gemini free tier).
# REPO_ASSIST_AGENT_MODEL=google:gemini-3.5-flash-lite
# REPO_ASSIST_JUDGE_MODEL=google:gemini-3.5-flash-lite
# REPO_ASSIST_DATA_DIR=data

# Vector search: Qdrant at this URL (docker-compose sets http://qdrant:6333). Unset = exact in-process search.
# REPO_ASSIST_QDRANT_URL=http://localhost:6333
