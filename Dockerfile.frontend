# repo-assist frontend -- thin React chat UI over the FastAPI backend.
# Multi-stage build: compile the Vite app, then serve the static output
# with a tiny nginx image rather than shipping node_modules at runtime.

FROM node:20-slim AS build

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html

# Vite's default build serves as a single-page app -- fall back to
# index.html for any unmatched path so client-side state isn't lost
# on refresh (this app has only one real page, but this is the correct
# default regardless).
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
